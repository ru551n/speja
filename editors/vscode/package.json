  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node scripts/package.mjs",
    "test": "node --experimental-strip-types src/generate.test.ts && node scripts/check-grammar.mjs && node scripts/check-themes.mjs",
    "smoke": "node test/smoke/run.mjs",
    "gen-themes": "node scripts/gen-themes.mjs"
  },

{
  "name": "speja",
  "displayName": "Speja VHDL",
  "description": "VHDL for VS Code: formatting and static analysis from the speja language server, plus syntax highlighting and editing actions such as instantiating an entity, declaring port map signals and generating a state machine.",
  "version": "0.13.0",
  "publisher": "ru551n",
  "icon": "icon.png",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ru551n/speja.git",
    "directory": "editors/vscode"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Themes"
  ],
  "keywords": [
    "vhdl",
    "fpga",
    "formatter",
    "linter",
    "vsg",
    "instantiate",
    "fsm"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:vhdl",
    "onView:speja.hierarchy"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vhdl",
        "aliases": [
          "VHDL"
        ],
        "extensions": [
          ".vhd",
          ".vhdl",
          ".vho",
          ".vht"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "speja",
      "properties": {
        "speja.server.mode": {
          "type": "string",
          "enum": [
            "embedded",
            "systemPath",
            "userPath"
          ],
          "enumDescriptions": [
            "Use the server bundled with this extension.",
            "Run `speja` from PATH.",
            "Run the executable named by speja.server.path."
          ],
          "default": "embedded",
          "description": "Which speja executable to run."
        },
        "speja.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to a speja executable, used when speja.server.mode is userPath. Point this at target/debug/speja to test a local build."
        },
        "speja.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between the editor and the server to the speja output channel."
        },
        "speja.waiverFile": {
          "type": "string",
          "default": "speja-waivers.yaml",
          "markdownDescription": "What a waiver file is called. The server looks for one beside the file being checked and in each directory above it, and creates one at the workspace root when the project has none. Pass the same file to the command line with `--waivers` so the editor and CI agree about what has been accepted."
        }
      }
    },
    "commands": [
      {
        "command": "speja.restartServer",
        "title": "Restart Server",
        "category": "speja"
      },
      {
        "command": "speja.showOutput",
        "title": "Show Output",
        "category": "speja"
      },
      {
        "command": "speja.showVersion",
        "title": "Show Server Version",
        "category": "speja"
      },
      {
        "command": "speja.waiveWithReason",
        "title": "Waive a Finding...",
        "category": "speja",
        "enablement": "false"
      },
      {
        "command": "speja.instantiateEntity",
        "title": "VHDL: Instantiate Entity",
        "category": "VHDL"
      },
      {
        "command": "speja.declareSignals",
        "title": "VHDL: Declare Signals for Port Map",
        "category": "VHDL"
      },
      {
        "command": "speja.fsmFromEnum",
        "title": "VHDL: Create State Machine from Enum Type",
        "category": "VHDL"
      },
      {
        "command": "speja.addUseClause",
        "title": "VHDL: Add Library and Use Clause for Symbol",
        "category": "VHDL"
      },
      {
        "command": "speja.componentDeclaration",
        "title": "VHDL: Declare Entity as Component",
        "category": "VHDL"
      },
      {
        "command": "speja.removeUnusedUseClauses",
        "title": "VHDL: Remove Unused Use Clauses",
        "category": "VHDL"
      },
      {
        "command": "speja.refreshHierarchy",
        "title": "Refresh",
        "category": "VHDL",
        "icon": "$(refresh)"
      },
      {
        "command": "speja.extractObject",
        "title": "VHDL: Extract Selection to Constant or Signal",
        "category": "VHDL"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == vhdl",
          "command": "speja.instantiateEntity",
          "group": "1_modification@1"
        },
        {
          "when": "editorLangId == vhdl",
          "command": "speja.declareSignals",
          "group": "1_modification@2"
        },
        {
          "when": "editorLangId == vhdl",
          "command": "speja.fsmFromEnum",
          "group": "1_modification@3"
        },
        {
          "when": "editorLangId == vhdl",
          "command": "speja.addUseClause",
          "group": "1_modification@4"
        },
        {
          "when": "editorLangId == vhdl",
          "command": "speja.componentDeclaration",
          "group": "1_modification@5"
        }
      ],
      "view/title": [
        {
          "command": "speja.refreshHierarchy",
          "when": "view == speja.hierarchy",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "speja.refreshHierarchy",
          "when": "false"
        }
      ]
    },
    "grammars": [
      {
        "language": "vhdl",
        "scopeName": "source.vhdl",
        "path": "./syntaxes/vhdl.tmLanguage.json"
      }
    ],
